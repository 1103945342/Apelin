#!/bin/sh
# dpkg runs postrm even when prerm was skipped or failed (--force-remove, a
# broken earlier state). Everything here has to be safe to repeat and safe
# when nothing is left to clean.

find_tool() {
    for candidate in "@PREFIX@/usr/bin/$1" "/usr/bin/$1" "/bin/$1"; do
        if [ -x "$candidate" ]; then
            echo "$candidate"
            return 0
        fi
    done
    return 1
}

# Named once, alone on its line: see postinst for why the id never sits next
# to a redirect.
label=com.fluoxetine.lurosd
if [ "${1:-}" = remove ] || [ "${1:-}" = purge ]; then
    if launchctl="$(find_tool launchctl)"; then
        "$launchctl" bootout "system/$label" 2>/dev/null || true
        "$launchctl" bootout "user/501/$label" 2>/dev/null || true
        "$launchctl" bootout "gui/501/$label" 2>/dev/null || true
    fi
fi

# Apelin wrote this job file itself in postinst, so no package removes it:
# dpkg does not know it, and postrm is the last chance to take it away. A file
# Irisin's own package wrote is a different name and is never touched.
iris_label=com.fluoxetine.luros.irisind
iris_plist="@PREFIX@/Library/LaunchDaemons/$iris_label.plist"
if [ "${1:-}" = remove ] || [ "${1:-}" = purge ]; then
    if launchctl="$(find_tool launchctl)"; then
        "$launchctl" bootout "system/$iris_label" 2>/dev/null || true
        "$launchctl" bootout "user/501/$iris_label" 2>/dev/null || true
        "$launchctl" bootout "gui/501/$iris_label" 2>/dev/null || true
    fi
    rm -f "${iris_plist:?}"
fi

exit 0
