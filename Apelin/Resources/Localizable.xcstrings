    "Keep the existing layout, update the title, and check the result on both screen sizes.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حافظ على التخطيط الحالي، وحدّث العنوان، وتحقق من النتيجة على كلا حجمي الشاشة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Behalte das bestehende Layout bei, aktualisiere den Titel und prüfe das Ergebnis auf beiden Bildschirmgrößen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén el diseño actual, actualiza el título y comprueba el resultado en ambos tamaños de pantalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conservez la mise en page actuelle, mettez à jour le titre et vérifiez le résultat sur les deux tailles d’écran."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantieni il layout esistente, aggiorna il titolo e controlla il risultato su entrambe le dimensioni dello schermo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "既存のレイアウトはそのままでタイトルを更新し、両方の画面サイズで結果を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기존 레이아웃은 유지하고 제목을 업데이트한 뒤, 두 화면 크기에서 결과를 확인해 주세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha o layout atual, atualize o título e confira o resultado nos dois tamanhos de tela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраните текущую раскладку, обновите заголовок и проверьте результат на обоих размерах экрана."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữ nguyên bố cục hiện tại, cập nhật tiêu đề và kiểm tra kết quả trên cả hai kích thước màn hình."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保留现有布局，更新标题，并在两种屏幕尺寸上检查结果。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保留現有版面，更新標題，並在兩種螢幕尺寸上檢查結果。"
          }
        }
      }
    },
    "Keeps the code as it is and takes the chat back to before this message.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى الشيفرة كما هي وتعود المحادثة إلى ما قبل هذه الرسالة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Behält den Code und setzt den Chat auf den Stand vor dieser Nachricht zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeps the code as it is and takes the chat back to before this message."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantiene el código como está y devuelve el chat a antes de este mensaje."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garde le code tel quel et ramène la discussion avant ce message."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lascia il codice com’è e riporta la chat a prima di questo messaggio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コードはそのままにして、チャットをこのメッセージの前に戻します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "코드는 그대로 두고 채팅만 이 메시지 이전으로 되돌립니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantém o código como está e volta o chat para antes desta mensagem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Код остаётся как есть, чат возвращается к состоянию до этого сообщения."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữ nguyên mã và đưa cuộc trò chuyện về trước tin nhắn này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保持当前代码，将对话回滚到这条消息之前。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保留目前的程式碼，將對話回復到這則訊息之前。"
          }
        }
