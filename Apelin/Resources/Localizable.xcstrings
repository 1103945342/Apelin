    "Resolve the conflicts and commit, or abort the merge.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حُلّ التعارضات وأودِع، أو ألغِ الدمج."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löse die Konflikte und committe, oder brich den Merge ab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Resuelve los conflictos y haz commit, o cancela la fusión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Résolvez les conflits et créez un commit, ou abandonnez la fusion."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Risolvi i conflitti ed esegui il commit, oppure annulla la fusione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "競合を解決してコミットするか、マージを中止してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "충돌을 해결하고 커밋하거나 병합을 중단하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Resolva os conflitos e faça commit, ou aborte a mesclagem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите конфликты и зафиксируйте изменения или отмените слияние."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy giải quyết xung đột rồi commit, hoặc hủy hợp nhất."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请解决冲突并提交，或中止合并。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請解決衝突並提交，或中止合併。"
          }
        }
      }
    },
