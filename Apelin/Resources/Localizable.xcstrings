    "Drop stash %lld? This action cannot be undone.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تجاهل الستاش %lld؟ لا يمكن التراجع عن هذا الإجراء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stash %lld verwerfen? Dieser Vorgang kann nicht rückgängig gemacht werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Descartar el stash %lld? Esta acción no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Abandonner le stash %lld ? Cette action est irréversible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scartare lo stash %lld? Questa azione non può essere annullata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スタッシュ %lld を破棄しますか？この操作は取り消せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스태시 %lld을(를) 버릴까요? 이 작업은 되돌릴 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Descartar o stash %lld? Esta ação não pode ser desfeita."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отменить стэш %lld? Это действие нельзя отменить."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bỏ stash %lld? Không thể hoàn tác thao tác này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "丢弃储藏 %lld？该操作不可撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "捨棄儲藏 %lld？此操作無法復原。"
          }
        }
      }
    },
