    "Publish": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نشر"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Veröffentlichen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Publicar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Publier"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pubblica"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "公開"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게시"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Publicar"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Опубликовать"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phát hành"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发布"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "發佈"
          }
        }
      }
    },
    "Publish or share that build as it is. Raise the version only to ship a change, so package managers offer it as an update.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انشر ذلك البناء أو شاركه كما هو. ارفع الإصدار فقط لنشر تغيير، كي تعرضه مديرات الحزم كتحديث."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Veröffentliche oder teile diesen Build so, wie er ist. Erhöhe die Version nur, um eine Änderung auszuliefern, damit Paketmanager sie als Update anbieten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Publica o comparte esa compilación tal como está. Sube la versión solo para publicar un cambio, para que los gestores de paquetes lo ofrezcan como actualización."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Publiez ou partagez cette compilation telle quelle. N’augmentez la version que pour livrer une modification, afin que les gestionnaires de paquets la proposent comme mise à jour."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pubblica o condividi quella build così com’è. Aumenta la versione solo per distribuire una modifica, così i gestori di pacchetti la offrono come aggiornamento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのビルドをそのまま公開または共有してください。バージョンを上げるのは変更を配布するときだけにしてください。そうすればパッケージマネージャがアップデートとして表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그 빌드를 그대로 게시하거나 공유하세요. 버전은 변경 사항을 배포할 때만 올리세요. 그래야 패키지 관리자가 업데이트로 제공합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Publique ou compartilhe essa compilação como está. Aumente a versão só para distribuir uma alteração, para que os gerenciadores de pacotes a ofereçam como atualização."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Опубликуйте эту сборку или поделитесь ею как есть. Повышайте версию, только чтобы выпустить изменение, — тогда менеджеры пакетов предложат его как обновление."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy phát hành hoặc chia sẻ bản dựng đó như hiện có. Chỉ tăng phiên bản khi phát hành thay đổi, để trình quản lý gói hiển thị nó dưới dạng bản cập nhật."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请直接发布或分享那次构建。只有要发布改动时才提高版本号，这样软件包管理器才会把它作为更新提供。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請直接發佈或分享那次建置。只有要發佈變更時才提高版本號，這樣套件管理器才會把它當作更新提供。"
          }
        }
      }
    },
    "Publish the selected packages to your package repository together, or share one. Each is the file its build made, unchanged.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انشر الحزم المحددة معًا في مستودع الحزم الخاص بك، أو شارك واحدة منها. كل منها هو الملف الذي أنتجه البناء، دون تغيير."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Veröffentliche die ausgewählten Pakete gemeinsam in deinem Paket-Repository oder teile eines davon. Jedes ist die Datei, die sein Build erstellt hat, unverändert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Publica juntos los paquetes seleccionados en tu repositorio de paquetes o comparte uno. Cada uno es el archivo que generó su compilación, sin cambios."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Publiez ensemble les paquets sélectionnés dans votre dépôt de paquets, ou partagez-en un. Chacun est le fichier produit par sa compilation, inchangé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pubblica insieme i pacchetti selezionati nel tuo repository di pacchetti, oppure condividine uno. Ognuno è il file prodotto dalla sua build, invariato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したパッケージをまとめてパッケージリポジトリに公開するか、1つを共有します。どれもビルドで作られたファイルそのままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 패키지를 패키지 저장소에 함께 게시하거나 하나를 공유하세요. 각 패키지는 빌드가 만든 파일 그대로입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Publique juntos os pacotes selecionados no seu repositório de pacotes ou compartilhe um deles. Cada um é o arquivo que a compilação gerou, sem alterações."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Опубликуйте выбранные пакеты вместе в своём репозитории пакетов или поделитесь одним из них. Каждый — это файл, созданный его сборкой, без изменений."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phát hành cùng lúc các gói đã chọn lên kho gói của bạn, hoặc chia sẻ một gói. Mỗi gói là tệp do bản dựng của nó tạo ra, không thay đổi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将所选软件包一起发布到你的软件源仓库，或分享其中一个。每个都是构建生成的原始文件，未经改动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將所選套件一起發佈到你的套件儲存庫，或分享其中一個。每個都是建置產生的原始檔案，未經更動。"
          }
        }
      }
    },
