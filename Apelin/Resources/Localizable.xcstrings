    "Every stash in this repository will be deleted. This cannot be undone.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيُحذف كل ستاش في هذا المستودع. لا يمكن التراجع عن ذلك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Stash in diesem Repository wird gelöscht. Das lässt sich nicht rückgängig machen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminarán todos los stashes de este repositorio. Esto no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les stash de ce dépôt seront supprimés. Action irréversible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti gli stash di questo repository verranno eliminati. L’operazione non può essere annullata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このリポジトリのすべてのスタッシュが削除されます。これは取り消せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 저장소의 모든 스태시가 삭제됩니다. 되돌릴 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os stashes deste repositório serão excluídos. Isso não pode ser desfeito."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все стэши в этом репозитории будут удалены. Отменить это нельзя."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi stash trong kho lưu trữ này sẽ bị xóa. Không thể hoàn tác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此仓库中的所有储藏都会被删除，且无法撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此儲存庫中的所有儲藏都會被刪除，且無法復原。"
          }
        }
      }
    },
