    "Tokens a conversation may take before your agent compacts it. Leave it empty to use what the model reports.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عدد الرموز التي يمكن أن تصل إليها المحادثة قبل أن يضغطها وكيلك. اترك الحقل فارغًا لاستخدام ما يذكره النموذج."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie viele Tokens ein Gespräch umfassen darf, bevor dein Agent es verdichtet. Leer lassen, um die Angabe des Modells zu verwenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tokens a conversation may take before your agent compacts it. Leave it empty to use what the model reports."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tokens que puede ocupar una conversación antes de que tu agente la compacte. Déjalo vacío para usar lo que indica el modelo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nombre de jetons qu’une conversation peut occuper avant que votre agent ne la compresse. Laissez vide pour utiliser ce qu’indique le modèle."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Token che una conversazione può occupare prima che il tuo agente la comprima. Lascia vuoto per usare quanto indicato dal modello."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントが会話を圧縮するまでに使えるトークン数です。空欄にするとモデルの値をそのまま使います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트가 대화를 압축하기 전까지 사용할 수 있는 토큰 수입니다. 비워 두면 모델이 알리는 값을 사용합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tokens que uma conversa pode ocupar antes de o seu agente compactá-la. Deixe vazio para usar o que o modelo informa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сколько токенов может занимать разговор, прежде чем агент его сожмёт. Оставьте пустым, чтобы взять значение модели."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Số token hội thoại có thể chiếm trước khi tác nhân nén lại. Để trống để dùng giá trị của mô hình."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对话在压缩前可占用的 Token 数。留空则使用模型自带的数值。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對話在壓縮前可佔用的 Token 數。留空則使用模型自帶的數值。"
          }
        }
      }
    },
