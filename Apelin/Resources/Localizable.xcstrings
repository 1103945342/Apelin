            "state": "translated",
            "value": "Scrivi e comprendi il tuo codice insieme a un agente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントと一緒にコードを書き、理解を深められます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트와 함께 코드를 작성하고 이해하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
