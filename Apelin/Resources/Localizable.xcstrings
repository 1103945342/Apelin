    "Your chats keep working, but Apelin can’t save them on this device until you free up space.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تستمر المحادثات في العمل، لكن لا يمكن لـ Apelin حفظها على هذا الجهاز حتى تُفرغ بعض المساحة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Chats laufen weiter, aber Apelin kann sie auf diesem Gerät erst speichern, wenn du Speicherplatz freigibst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your chats keep working, but Apelin can’t save them on this device until you free up space."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus chats siguen funcionando, pero Apelin no puede guardarlos en este dispositivo hasta que liberes espacio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos discussions continuent de fonctionner, mais Apelin ne peut pas les enregistrer sur cet appareil tant que vous n’avez pas libéré de l’espace."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le chat continuano a funzionare, ma Apelin non può salvarle su questo dispositivo finché non liberi spazio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チャットは引き続き使用できますが、空き領域を確保するまで、Apelinはこのデバイスにチャットを保存できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "채팅은 계속 사용할 수 있지만, 공간을 확보할 때까지 Apelin이 이 기기에 채팅을 저장할 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas conversas continuam funcionando, mas o Apelin não pode salvá-las neste dispositivo até você liberar espaço."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чаты продолжают работать, но Apelin не сможет сохранить их на этом устройстве, пока вы не освободите место."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các cuộc trò chuyện vẫn hoạt động, nhưng Apelin không thể lưu chúng trên thiết bị này cho đến khi bạn giải phóng dung lượng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "聊天可以继续，但在你腾出空间之前，Apelin 无法把它们保存到这台设备上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "聊天可以繼續進行，但在你釋放空間之前，Apelin 無法將聊天儲存到此裝置。"
          }
        }
      }
    },
    "Your new project “%@” is ready. Your agent will give it a better name later.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مشروعك الجديد «%@» جاهز. سيمنحه الوكيل اسمًا أفضل لاحقًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein neues Projekt „%@“ ist bereit. Dein Agent gibt ihm später einen besseren Namen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your new project “%@” is ready. Your agent will give it a better name later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu nuevo proyecto “%@” está listo. Tu agente le dará un nombre mejor más adelante."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre nouveau projet « %@ » est prêt. Votre agent lui donnera un meilleur nom plus tard."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo nuovo progetto “%@” è pronto. L’agente gli darà un nome migliore più avanti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいプロジェクト「%@」の準備ができました。あとでエージェントがよりよい名前を付けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 프로젝트 ‘%@’이(가) 준비되었습니다. 나중에 에이전트가 더 나은 이름을 지정합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu novo projeto “%@” está pronto. Seu agente dará a ele um nome melhor depois."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Новый проект «%@» готов. Позже агент даст ему название получше."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dự án mới “%@” đã sẵn sàng. Tác nhân sẽ đặt cho nó một cái tên phù hợp hơn sau."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的新项目“%@”已经就绪，稍后智能体会为它起一个更好的名字。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的新專案「%@」已就緒，稍後代理程式會為它取一個更好的名稱。"
          }
        }
      }
    },
