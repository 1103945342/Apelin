    "An item with the same name or identifier already exists.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يوجد بالفعل عنصر بالاسم أو المعرّف نفسه."
          }
        },
        "de": {
