    "Untracked files are left behind unless you take them.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُترك الملفات غير المتتبعة في مكانها ما لم تأخذها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht verfolgte Dateien bleiben zurück, sofern du sie nicht mitnimmst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los archivos sin seguimiento se quedan atrás a menos que los lleves contigo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers non suivis restent en place, sauf si vous les emportez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I file non tracciati restano dove sono, a meno che tu non li porti con te."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未追跡のファイルは、持ち出さない限りそのまま残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "추적하지 않는 파일은 직접 가져가지 않는 한 그대로 남습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arquivos não rastreados ficam para trás, a menos que você os leve."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Неотслеживаемые файлы остаются на месте, если их не забрать."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các tệp chưa theo dõi sẽ bị bỏ lại trừ khi bạn mang chúng theo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未跟踪的文件会留在原处，除非你把它们带走。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未追蹤的檔案會留在原處，除非你把它們帶走。"
          }
        }
      }
    },
