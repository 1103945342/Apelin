          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicie sessão na conta que o agente usa para escrever, compilar e instalar seus tweaks."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Войдите в учётную запись, с помощью которой агент пишет, собирает и устанавливает ваши твики."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đăng nhập vào tài khoản mà tác nhân dùng để viết, xây dựng và cài đặt tweak của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
