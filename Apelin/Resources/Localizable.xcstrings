          "stringUnit": {
            "state": "translated",
            "value": "현재 브랜치를 커밋 %@(으)로 재설정할까요?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Redefinir o branch atual para o commit %@?"
          }
        },
        "ru": {
