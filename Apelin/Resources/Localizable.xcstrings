    },
    "An environment task is already running. You can continue now and check its progress in Settings.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هناك مهمة بيئة قيد التشغيل بالفعل. يمكنك المتابعة الآن ومتابعة تقدمها في «الإعدادات»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Umgebungsaufgabe läuft bereits. Du kannst jetzt fortfahren und den Fortschritt in den Einstellungen verfolgen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An environment task is already running. You can continue now and check its progress in Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya hay una tarea del entorno en curso. Puedes continuar ahora y consultar su progreso en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une tâche d’environnement est déjà en cours. Vous pouvez continuer maintenant et suivre sa progression dans Réglages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un’attività dell’ambiente è già in corso. Puoi continuare ora e seguirne l’avanzamento in Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "環境のタスクがすでに実行中です。このまま続行して、進行状況は「設定」で確認できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "환경 작업이 이미 실행 중입니다. 지금 계속 진행하고 ‘설정’에서 진행 상황을 확인할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma tarefa do ambiente já está em andamento. Você pode continuar agora e acompanhar o progresso em Ajustes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Задача среды уже выполняется. Можно продолжить сейчас и следить за ходом в «Настройках»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một tác vụ môi trường đang chạy. Bạn có thể tiếp tục ngay và xem tiến trình trong Cài đặt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已有环境任务正在运行。你可以继续，并在设置中查看进度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已有環境任務正在執行。你可以繼續，並在「設定」中查看進度。"
          }
        }
      }
    },
    "An installation is in progress. Check Settings for details.": {
