    "All files will be unstaged, but their contents will not be deleted. Continue?": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستُلغى تجهيزات كل الملفات، لكن لن تُحذف محتوياتها. متابعة؟"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Dateien werden aus der Vormerkung genommen, ihr Inhalt wird jedoch nicht gelöscht. Fortfahren?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se quitarán todos los archivos de la preparación, pero su contenido no se eliminará. ¿Continuar?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les fichiers seront désindexés, mais leur contenu ne sera pas supprimé. Continuer ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti i file verranno tolti dallo stage, ma i loro contenuti non saranno eliminati. Continuare?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのファイルのステージを取り消しますが、内容は削除されません。続けますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 파일의 스테이징이 취소되지만 파일 내용은 삭제되지 않습니다. 계속할까요?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os arquivos serão removidos da preparação, mas seu conteúdo não será excluído. Continuar?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все файлы будут убраны из индекса, но их содержимое не удалится. Продолжить?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tất cả tệp sẽ được bỏ khỏi vùng chờ, nhưng nội dung của chúng sẽ không bị xóa. Tiếp tục?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将取消所有文件的暂存，但不会删除文件内容。确定继续吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將取消所有檔案的暫存，但不會刪除檔案內容。確定要繼續嗎？"
          }
        }
      }
    },
    "Allow Apelin to add photos in Settings.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
