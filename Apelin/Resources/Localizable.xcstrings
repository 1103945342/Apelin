    "Apelin opens toolchains (.apetc), SDKs (.apesdk) and projects (.apeproj).": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفتح Apelin سلاسل الأدوات (.apetc) وSDK (.apesdk) والمشاريع (.apeproj)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apelin öffnet Toolchains (.apetc), SDKs (.apesdk) und Projekte (.apeproj)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apelin abre cadenas de herramientas (.apetc), SDK (.apesdk) y proyectos (.apeproj)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apelin ouvre les chaînes d’outils (.apetc), les SDK (.apesdk) et les projets (.apeproj)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apelin apre toolchain (.apetc), SDK (.apesdk) e progetti (.apeproj)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apelinで開けるのは、ツールチェーン（.apetc）、SDK（.apesdk）、プロジェクト（.apeproj）です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apelin은 툴체인(.apetc), SDK(.apesdk), 프로젝트(.apeproj)를 열 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Apelin abre cadeias de ferramentas (.apetc), SDKs (.apesdk) e projetos (.apeproj)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Apelin открывает наборы инструментов (.apetc), SDK (.apesdk) и проекты (.apeproj)."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apelin mở được chuỗi công cụ (.apetc), SDK (.apesdk) và dự án (.apeproj)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apelin 可以打开工具链（.apetc）、SDK（.apesdk）和项目（.apeproj）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Apelin 可以打開工具鏈（.apetc）、SDK（.apesdk）和專案（.apeproj）。"
          }
        }
      }
    },
    "Apelin’s background service could not be reached. Try again in a moment.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر الوصول إلى خدمة Apelin في الخلفية. حاول مرة أخرى بعد قليل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Hintergrunddienst von Apelin ist nicht erreichbar. Versuche es gleich noch einmal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido contactar con el servicio en segundo plano de Apelin. Inténtalo de nuevo en un momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de joindre le service d’arrière-plan d’Apelin. Réessayez dans un instant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile raggiungere il servizio in background di Apelin. Riprova tra poco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apelinのバックグラウンドサービスに接続できませんでした。しばらくしてからもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apelin 백그라운드 서비스에 연결할 수 없습니다. 잠시 후 다시 시도하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível acessar o serviço em segundo plano do Apelin. Tente novamente em instantes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось связаться с фоновой службой Apelin. Повторите попытку чуть позже."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể kết nối với dịch vụ nền của Apelin. Hãy thử lại sau giây lát."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法连接 Apelin 的后台服务。请稍后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法連線至 Apelin 的背景服務。請稍後再試一次。"
          }
        }
      }
    },
    "Apelin’s background service did not answer within %@. Try again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تستجب خدمة Apelin في الخلفية خلال %@. حاول مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Hintergrunddienst von Apelin hat nicht innerhalb von %@ geantwortet. Versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servicio en segundo plano de Apelin no respondió en %@. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le service d’arrière-plan d’Apelin n’a pas répondu dans un délai de %@. Réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il servizio in background di Apelin non ha risposto entro %@. Riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apelinのバックグラウンドサービスが%@以内に応答しませんでした。もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apelin 백그라운드 서비스가 %@ 이내에 응답하지 않았습니다. 다시 시도하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O serviço em segundo plano do Apelin não respondeu em %@. Tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Фоновая служба Apelin не ответила в течение %@. Повторите попытку."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dịch vụ nền của Apelin không phản hồi trong %@. Hãy thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apelin 的后台服务在 %@内没有响应，请重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Apelin 的背景服務未在 %@內回應，請再試一次。"
          }
        }
      }
    },
    "Apelin’s background service is unavailable. Reinstall Apelin with your preferred package manager to restore it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خدمة Apelin في الخلفية غير متاحة. أعد تثبيت Apelin باستخدام مدير الحزم المفضّل لديك لاستعادتها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Hintergrunddienst von Apelin ist nicht verfügbar. Installiere Apelin mit deinem bevorzugten Paketmanager neu, um ihn wiederherzustellen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servicio en segundo plano de Apelin no está disponible. Vuelve a instalar Apelin con tu gestor de paquetes preferido para restaurarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le service d’arrière-plan d’Apelin est indisponible. Réinstallez Apelin avec votre gestionnaire de paquets préféré pour le rétablir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il servizio in background di Apelin non è disponibile. Reinstalla Apelin con il tuo gestore di pacchetti preferito per ripristinarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apelinのバックグラウンドサービスを利用できません。復元するには、お使いのパッケージマネージャでApelinを再インストールしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apelin 백그라운드 서비스를 사용할 수 없습니다. 복구하려면 선호하는 패키지 관리자로 Apelin을 다시 설치하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O serviço em segundo plano do Apelin não está disponível. Reinstale o Apelin com seu gerenciador de pacotes preferido para restaurá-lo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Фоновая служба Apelin недоступна. Чтобы восстановить её, переустановите Apelin через удобный вам менеджер пакетов."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dịch vụ nền của Apelin không khả dụng. Hãy cài đặt lại Apelin bằng trình quản lý gói bạn ưa dùng để khôi phục."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apelin 的后台服务不可用。请用你喜欢的软件包管理器重新安装 Apelin 来恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法使用 Apelin 的背景服務。請使用你偏好的套件管理器重新安裝 Apelin 以恢復。"
          }
        }
      }
    },
    "Apelin’s background service is unavailable. Reinstall Apelin with your preferred package manager to sign in.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خدمة Apelin في الخلفية غير متاحة. أعد تثبيت Apelin باستخدام مدير الحزم المفضّل لديك لتسجيل الدخول."
          }
        },
        "de": {
          "stringUnit": {
