    "“%@” is still working. It will be stopped, then deleted with its messages. This cannot be undone.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تزال «%@» قيد العمل. ستُوقف ثم تُحذف مع رسائلها. لا يمكن التراجع عن هذا الإجراء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ läuft noch. Der Chat wird gestoppt und dann mit seinen Nachrichten gelöscht. Das kann nicht widerrufen werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” sigue en curso. Se detendrá y después se eliminará con sus mensajes. Esta acción no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » est toujours en cours. La discussion sera arrêtée, puis supprimée avec ses messages. Cette action est irréversible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” è ancora in corso. Verrà interrotta e poi eliminata con i suoi messaggi. Questa azione non può essere annullata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」はまだ処理中です。停止してから、メッセージとともに削除されます。この操作は取り消せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘%@’ 채팅이 아직 작업 중입니다. 중지한 다음 메시지와 함께 삭제됩니다. 이 작업은 되돌릴 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” ainda está em andamento. A conversa será parada e depois apagada com suas mensagens. Isso não pode ser desfeito."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чат «%@» ещё в работе. Он будет остановлен, а затем удалён вместе с сообщениями. Это нельзя отменить."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” vẫn đang làm việc. Cuộc trò chuyện sẽ được dừng rồi xóa cùng các tin nhắn. Không thể hoàn tác thao tác này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”仍在工作。将先停止它，再连同消息一起删除。此操作无法撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」仍在進行中。將先停止它，再連同訊息一起刪除。此操作無法復原。"
          }
        }
      }
    },
