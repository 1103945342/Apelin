    "The folder and everything in it will be deleted. This cannot be undone.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم حذف المجلد وكل ما فيه. لا يمكن التراجع عن ذلك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Ordner und alles darin werden gelöscht. Das lässt sich nicht rückgängig machen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminará la carpeta y todo su contenido. No se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dossier et tout son contenu seront supprimés. Action irréversible."
          }
        },
        "it": {
