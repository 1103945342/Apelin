    "Abort Merge": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إلغاء الدمج"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Merge abbrechen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelar fusión"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Abandonner la fusion"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Annulla la fusione"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マージを中止"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "병합 중단"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abortar mesclagem"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отменить слияние"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hủy hợp nhất"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "中止合并"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "中止合併"
          }
        }
      }
    },
    "Abort the Merge?": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إلغاء الدمج؟"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Merge abbrechen?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Cancelar la fusión?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Abandonner la fusion ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Annullare la fusione?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マージを中止しますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "병합을 중단할까요?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abortar a mesclagem?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отменить слияние?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hủy hợp nhất?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要中止合并吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要中止合併嗎？"
          }
        }
      }
    },
    "Abort the current merge? Unresolved changes will be discarded and the working tree will be restored.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إلغاء الدمج الحالي؟ ستُتجاهل التغييرات غير المحلولة وستُستعاد شجرة العمل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktuellen Merge abbrechen? Ungelöste Änderungen werden verworfen und das Arbeitsverzeichnis wird wiederhergestellt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Cancelar la fusión actual? Los cambios sin resolver se descartarán y el árbol de trabajo se restaurará."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Abandonner la fusion en cours ? Les modifications non résolues seront abandonnées et l’arbre de travail sera restauré."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Annullare la fusione in corso? Le modifiche non risolte verranno scartate e il work tree sarà ripristinato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のマージを中止しますか？未解決の変更は破棄され、作業ツリーは元に戻ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 병합을 중단할까요? 해결되지 않은 변경 사항은 버려지고 작업 트리가 복원됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abortar a mesclagem atual? As alterações não resolvidas serão descartadas e a árvore de trabalho será restaurada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отменить текущее слияние? Неразрешённые изменения будут отменены, а рабочее дерево восстановлено."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hủy hợp nhất hiện tại? Các thay đổi chưa giải quyết sẽ bị bỏ và cây làm việc sẽ được khôi phục."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确定中止当前合并吗？未解决的冲突改动将被放弃，工作区将还原到合并前的状态。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
