    "The author of your commits, your GitHub account, and the package repository your releases are published to.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مؤلف التزاماتك، وحساب GitHub الخاص بك، ومستودع الحزم الذي تُنشر إليه إصداراتك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Autor deiner Commits, dein GitHub-Konto und das Paket-Repository, in dem deine Releases veröffentlicht werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El autor de tus confirmaciones, tu cuenta de GitHub y el repositorio de paquetes donde se publican tus versiones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’auteur de vos commits, votre compte GitHub et le dépôt de paquets où sont publiées vos versions."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’autore dei tuoi commit, il tuo account GitHub e il repository di pacchetti in cui vengono pubblicate le tue versioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コミットの作成者、GitHubアカウント、リリースを公開するパッケージリポジトリです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "커밋 작성자, GitHub 계정, 릴리스를 게시하는 패키지 저장소입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O autor dos seus commits, sua conta do GitHub e o repositório de pacotes onde suas versões são publicadas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Автор ваших коммитов, ваш аккаунт GitHub и репозиторий пакетов, куда публикуются ваши релизы."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tác giả của các commit, tài khoản GitHub của bạn và kho gói nơi các bản phát hành của bạn được phát hành."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提交的作者、你的 GitHub 账户，以及发布版本所在的软件源仓库。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "提交的作者、你的 GitHub 帳號，以及發佈版本所在的套件儲存庫。"
          }
        }
      }
    },
    "The build makes a .deb your package manager installs on a jailbroken device.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبني المشروع حزمة .deb يثبّتها مدير الحزم على جهاز مكسور الحماية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Build erzeugt ein .deb, das dein Paketmanager auf einem jailbroken Gerät installiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The build makes a .deb your package manager installs on a jailbroken device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La compilación genera un .deb que tu gestor de paquetes instala en un dispositivo con jailbreak."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La compilation produit un .deb que votre gestionnaire de paquets installe sur un appareil jailbreaké."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La build produce un .deb che il tuo gestore di pacchetti installa su un dispositivo jailbroken."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ビルドは、脱獄したデバイスにパッケージマネージャがインストールする .deb を出力します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빌드는 탈옥한 기기에 패키지 관리자가 설치하는 .deb를 만듭니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A compilação gera um .deb que seu gerenciador de pacotes instala em um dispositivo com jailbreak."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сборка создаёт .deb, который ваш менеджер пакетов установит на устройство с джейлбрейком."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản dựng tạo một .deb mà trình quản lý gói của bạn cài trên thiết bị đã jailbreak."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "构建会生成 .deb 软件包，由包管理器安装到越狱设备上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "建置會產生 .deb 套件，由套件管理器安裝到越獄裝置上。"
          }
        }
      }
    },
    "The build makes one minimal app as an .ipa. Install it on this device, or export it in Distribute… to sign it for another.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبني المشروع تطبيقًا بسيطًا واحدًا بصيغة .ipa. ثبّته على هذا الجهاز، أو صدّره من «توزيع…» لتوقيعه لجهاز آخر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Build erzeugt eine minimale App als .ipa. Installiere sie hier oder exportiere sie in „Verteilen…“, um sie für ein anderes Gerät zu signieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The build makes one minimal app as an .ipa. Install it on this device, or export it in Distribute… to sign it for another."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La compilación genera una app mínima como .ipa. Instálala aquí o expórtala en «Distribuir…» para firmarla para otro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La compilation produit une app minimale au format .ipa. Installez-la ici ou exportez-la dans « Distribuer… » pour la signer pour un autre appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La build produce un’app minima come .ipa. Installala qui o esportala in «Distribuisci…» per firmarla per un altro dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ビルドは最小限のアプリを .ipa として出力します。このデバイスにインストールするか、「配布…」で書き出して別のデバイス向けに署名します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빌드는 최소한의 앱을 .ipa로 만듭니다. 이 기기에 설치하거나 ‘배포…’에서 내보내 다른 기기에 맞게 서명하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A compilação gera um app mínimo como .ipa. Instale aqui ou exporte em “Distribuir…” para assiná-lo para outro dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сборка создаёт минимальное приложение в виде .ipa. Установите его здесь или экспортируйте в «Распространить…», чтобы подписать для другого устройства."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản dựng tạo một ứng dụng tối giản dưới dạng .ipa. Cài trên thiết bị này, hoặc xuất trong “Phân phối…” để ký cho thiết bị khác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "构建会生成一个最简 iOS 应用的 .ipa。可安装到本机，或在「分发…」中导出，为另一台设备签名。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "建置會產生一個最簡 iOS 應用程式的 .ipa。可安裝到本機，或在「分發…」中匯出，為另一台裝置簽名。"
          }
        }
      }
    },
