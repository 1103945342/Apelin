          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Фоновая служба Apelin недоступна. Чтобы войти, переустановите Apelin через удобный вам менеджер пакетов."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dịch vụ nền của Apelin không khả dụng. Hãy cài đặt lại Apelin bằng trình quản lý gói bạn ưa dùng để đăng nhập."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apelin 的后台服务不可用。请用你喜欢的软件包管理器重新安装 Apelin 后再登录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
