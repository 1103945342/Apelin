    "Restore the deleted %@? The file will be brought back from the last commit.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استعادة %@ المحذوف؟ سيُستعاد الملف من الإيداع الأخير."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die gelöschte Datei %@ wiederherstellen? Sie wird aus dem letzten Commit zurückgeholt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Restaurar %@ eliminado? El archivo se recuperará del último commit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaurer %@ supprimé ? Le fichier sera récupéré depuis le dernier commit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
