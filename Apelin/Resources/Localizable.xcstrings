    "This branch is “master” and tracks nothing. Push it to main instead, or keep master as it is.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا الفرع هو “master” ولا يتتبع شيئًا. ادفعه إلى main بدلًا من ذلك، أو أبقِ master كما هو."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Branch ist „master“ und verfolgt nichts. Pushe ihn stattdessen nach main, oder behalte master so, wie er ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta rama es «master» y no sigue nada. Haz push a main en su lugar, o mantén master como está."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette branche est « master » et ne suit rien. Poussez-la plutôt vers main, ou gardez master telle quelle."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo branch è “master” e non traccia nulla. Esegui il push su main, oppure lascia master com’è."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このブランチは「master」で、何も追跡していません。代わりに main へプッシュするか、master をそのままにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 브랜치는 “master”이며 아무것도 추적하지 않습니다. 대신 main으로 푸시하거나 master를 그대로 두세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este branch é “master” e não rastreia nada. Faça push para main, ou mantenha master como está."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта ветка — «master» и ничего не отслеживает. Отправьте её в main или оставьте master как есть."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhánh này là “master” và không theo dõi gì cả. Hãy push lên main, hoặc giữ master như hiện tại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此分支是 “master”，不跟踪任何内容。请改为推送到 main，或保留 master 不变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此分支是「master」，不追蹤任何內容。請改為推送到 main，或保留 master 不變。"
          }
        }
      }
    },
