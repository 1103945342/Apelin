    "Only “Hi” is sent, without a system prompt, conversation history or tools.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تُرسل إلا «Hi»، من دون مطالبة نظام أو سجل محادثة أو أدوات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wird nur „Hi“ gesendet – ohne Systemanweisung, Gesprächsverlauf oder Tools."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only “Hi” is sent, without a system prompt, conversation history or tools."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se envía «Hi», sin instrucciones del sistema, historial de conversación ni herramientas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seul « Hi » est envoyé, sans invite système, historique de conversation ni outils."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Viene inviato solo «Hi», senza prompt di sistema, cronologia della conversazione o strumenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムプロンプト、会話履歴、ツールを含めず、「Hi」のみを送信します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 프롬프트, 대화 기록 또는 도구 없이 “Hi”만 전송됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas “Hi” é enviado, sem um prompt de sistema, histórico da conversa ou ferramentas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправляется только «Hi» — без системного запроса, истории разговора и инструментов."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ gửi “Hi”, không có lời nhắc hệ thống, lịch sử cuộc trò chuyện hay công cụ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只发送“Hi”，不包含系统提示、对话历史或工具。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只會傳送「Hi」，不包含系統提示、對話記錄或工具。"
          }
        }
      }
    },
