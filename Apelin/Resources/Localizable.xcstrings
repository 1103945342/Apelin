    "Agent sessions that use it stop working until you sign in again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستتوقف جلسات الوكيل التي تستخدمه عن العمل حتى تسجّل الدخول مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent-Sitzungen, die ihn verwenden, funktionieren erst wieder, wenn du dich erneut anmeldest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las sesiones del agente que lo usan dejarán de funcionar hasta que vuelvas a iniciar sesión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les sessions d’agent qui l’utilisent cessent de fonctionner jusqu’à ce que vous vous reconnectiez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le sessioni dell’agente che lo usano smettono di funzionare finché non accedi di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これを使用しているエージェントのセッションは、もう一度サインインするまで動作しなくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 계정을 사용하는 에이전트 세션은 다시 로그인할 때까지 작동하지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As sessões do agente que o usam deixarão de funcionar até você iniciar sessão novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сеансы агента, которые его используют, перестанут работать, пока вы не войдёте снова."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các phiên tác nhân dùng nó sẽ ngừng hoạt động cho đến khi bạn đăng nhập lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用它的智能体会话将无法工作，直到你重新登录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用它的代理程式工作階段將無法運作，直到你重新登入。"
          }
        }
      }
    },
    "Agents can make mistakes. Review generated code and important changes before you run or install them.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قد يخطئ الوكلاء. راجِع الشيفرة المُنشأة والتغييرات المهمة قبل تشغيلها أو تثبيتها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Agenten können Fehler machen. Prüfe generierten Code und wichtige Änderungen, bevor du sie ausführst oder installierst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Agents can make mistakes. Review generated code and important changes before you run or install them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los agentes pueden cometer errores. Revisa el código generado y los cambios importantes antes de ejecutarlos o instalarlos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les agents peuvent commettre des erreurs. Examinez le code généré et les modifications importantes avant de les exécuter ou de les installer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli agenti possono commettere errori. Controlla il codice generato e le modifiche importanti prima di eseguirli o installarli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントは間違えることがあります。実行やインストールの前に、生成されたコードと重要な変更を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트는 실수할 수 있습니다. 실행하거나 설치하기 전에 생성된 코드와 중요한 변경 사항을 검토하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os agentes podem cometer erros. Revise o código gerado e as alterações importantes antes de executá-los ou instalá-los."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Агенты могут ошибаться. Проверяйте сгенерированный код и важные изменения перед запуском или установкой."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tác nhân có thể mắc lỗi. Xem lại mã được tạo và các thay đổi quan trọng trước khi chạy hoặc cài đặt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "智能体可能会犯错。运行或安装前，请检查生成的代码和重要改动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "智慧體可能會犯錯。執行或安裝前，請先檢視產生的程式碼和重要變更。"
          }
        }
      }
    },
