    "First-event and first-text times are measured from request start. Other rows show stage durations.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُقاس أوقات أول حدث وأول نص منذ بدء الطلب. وتعرض الصفوف الأخرى مدد المراحل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zeiten bis zum ersten Ereignis und Text werden ab Beginn der Anfrage gemessen. Die anderen Zeilen zeigen die Dauer der einzelnen Phasen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "First-event and first-text times are measured from request start. Other rows show stage durations."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los tiempos del primer evento y del primer texto se miden desde el inicio de la solicitud. Las demás filas muestran la duración de cada etapa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les temps jusqu’au premier événement et au premier texte sont mesurés depuis le début de la requête. Les autres lignes indiquent la durée des étapes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tempi del primo evento e del primo testo sono misurati dall’inizio della richiesta. Le altre righe mostrano la durata delle fasi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最初のイベントと最初のテキストまでの時間は、リクエスト開始時点から測定されます。ほかの行には各段階の所要時間が表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "첫 이벤트와 첫 텍스트까지의 시간은 요청 시작부터 측정됩니다. 다른 행에는 각 단계의 소요 시간이 표시됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os tempos até o primeiro evento e o primeiro texto são medidos desde o início da solicitação. As outras linhas mostram a duração das etapas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Время до первого события и первого текста измеряется от начала запроса. В остальных строках указана длительность этапов."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thời gian đến sự kiện đầu tiên và văn bản đầu tiên được đo từ lúc bắt đầu yêu cầu. Các hàng khác hiển thị thời lượng từng giai đoạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "首个事件和首段文本的耗时从请求开始计量，其他行显示各阶段耗时。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "第一個事件和第一段文字的耗時從要求開始計算，其他列顯示各階段耗時。"
          }
        }
      }
    },
