    "Apelin’s background service returned an incomplete response. Try again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أعادت خدمة Apelin في الخلفية استجابة غير مكتملة. حاول مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Hintergrunddienst von Apelin hat eine unvollständige Antwort gesendet. Versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servicio en segundo plano de Apelin devolvió una respuesta incompleta. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le service d’arrière-plan d’Apelin a renvoyé une réponse incomplète. Réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il servizio in background di Apelin ha restituito una risposta incompleta. Riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apelinのバックグラウンドサービスから不完全な応答が返されました。もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apelin 백그라운드 서비스가 불완전한 응답을 반환했습니다. 다시 시도하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O serviço em segundo plano do Apelin retornou uma resposta incompleta. Tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Фоновая служба Apelin вернула неполный ответ. Повторите попытку."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dịch vụ nền của Apelin trả về phản hồi không đầy đủ. Hãy thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
