            "state": "translated",
            "value": "اضغط على “+” لإضافة ذكرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf „+“, um eine Erinnerung hinzuzufügen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca “+” para añadir un recuerdo."
          }
        },
        "fr": {
