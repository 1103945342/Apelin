    },
    "The package changed after it was built. Build it again before exporting.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغيّرت الحزمة بعد بنائها. ابنِها مرة أخرى قبل التصدير."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Paket wurde nach dem Bauen verändert. Baue es vor dem Exportieren erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The package changed after it was built. Build it again before exporting."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El paquete cambió después de compilarse. Vuelve a compilarlo antes de exportarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le paquet a changé après sa compilation. Compilez-le à nouveau avant de l’exporter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il pacchetto è cambiato dopo la compilazione. Compilalo di nuovo prima di esportarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ビルド後にパッケージが変更されました。エクスポートする前にもう一度ビルドしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빌드 후 패키지가 변경되었습니다. 내보내기 전에 다시 빌드하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O pacote mudou depois de ser compilado. Compile-o novamente antes de exportar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пакет изменился после сборки. Соберите его снова перед экспортом."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gói đã thay đổi sau khi được xây dựng. Hãy xây dựng lại trước khi xuất."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安装包在构建后发生了变化。请重新构建后再导出。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "套件在建置後已變更。請重新建置後再匯出。"
          }
        }
      }
    },
    "The package could not be built. Check the build script’s log and try again.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر بناء الحزمة. تحقق من سجل سكربت البناء وحاول مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Paket konnte nicht gebaut werden. Prüfe das Protokoll des Build-Skripts und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The package could not be built. Check the build script’s log and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido compilar el paquete. Revisa el registro del script de compilación e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de compiler le paquet. Vérifiez le journal du script de compilation et réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile compilare il pacchetto. Controlla il log dello script di build e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パッケージをビルドできませんでした。ビルドスクリプトのログを確認して、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "패키지를 빌드할 수 없습니다. 빌드 스크립트의 로그를 확인한 후 다시 시도하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível compilar o pacote. Verifique o registro do script de compilação e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось собрать пакет. Проверьте журнал скрипта сборки и повторите попытку."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể xây dựng gói. Hãy kiểm tra nhật ký của tập lệnh bản dựng rồi thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法构建安装包。请检查构建脚本的日志后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法建置套件。請檢查建置指令碼的日誌後再試一次。"
          }
        }
      }
    },
