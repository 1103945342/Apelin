    "Choose a display name. The project folder and build settings stay the same.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر اسمًا للعرض. يبقى مجلد المشروع وإعدادات البناء كما هي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle einen Anzeigenamen. Projektordner und Build-Einstellungen bleiben unverändert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un nombre visible. La carpeta del proyecto y los ajustes de compilación no cambian."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un nom d’affichage. Le dossier du projet et les réglages de compilation restent inchangés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli un nome visualizzato. La cartella del progetto e le impostazioni di build restano invariate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
