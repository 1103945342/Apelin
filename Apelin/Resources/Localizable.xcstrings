    "This account has no repositories of its own.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يملك هذا الحساب مستودعات خاصة به."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Konto hat keine eigenen Repositorys."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta cuenta no tiene repositorios propios."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce compte n’a aucun dépôt à lui."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo account non ha repository propri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアカウントには自分のリポジトリがありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 계정에는 소유한 저장소가 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
