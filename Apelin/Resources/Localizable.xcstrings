          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除された %@ を復元しますか？最後のコミットからファイルを戻します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "삭제된 %@을(를) 복원할까요? 마지막 커밋에서 파일을 가져옵니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaurar %@ excluído? O arquivo será recuperado do último commit."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Восстановить удалённый %@? Файл будет возвращён из последнего коммита."
