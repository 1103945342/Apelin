    "Restore %@ to its last committed content? Both staged and unstaged changes to this file will be lost and cannot be recovered.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استعادة %@ إلى آخر محتوى مُودَع؟ ستُفقد تغييرات هذا الملف المجهّزة وغير المجهّزة ولن يمكن استعادتها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ auf den zuletzt committeten Stand zurücksetzen? Sowohl vorgemerkte als auch nicht vorgemerkte Änderungen an dieser Datei gehen verloren und können nicht wiederhergestellt werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Restaurar %@ a su último contenido commiteado? Se perderán los cambios preparados y sin preparar de este archivo y no se podrán recuperar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaurer %@ à son dernier contenu commité ? Les modifications indexées et non indexées de ce fichier seront perdues et ne pourront pas être récupérées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ripristinare %@ all’ultimo contenuto committato? Le modifiche in stage e non di questo file andranno perse e non potranno essere recuperate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ を最後にコミットした内容に戻しますか？このファイルのステージ済み・未ステージの変更はすべて失われ、復元できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@을(를) 마지막으로 커밋된 내용으로 복원할까요? 이 파일의 스테이징된 변경 사항과 스테이징되지 않은 변경 사항이 모두 사라지며 복구할 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaurar %@ ao último conteúdo commitado? As alterações preparadas e não preparadas deste arquivo serão perdidas e não poderão ser recuperadas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Восстановить %@ до последнего закоммиченного содержимого? И проиндексированные, и непроиндексированные изменения этого файла будут потеряны без возможности восстановления."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khôi phục %@ về nội dung đã commit gần nhất? Cả thay đổi đã đưa vào vùng chờ và chưa đưa vào vùng chờ của tệp này sẽ mất và không thể khôi phục."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把 %@ 还原到上次提交的内容？该文件已暂存和未暂存的改动都会丢失，且无法找回。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把 %@ 還原到上次提交的內容？該檔案已暫存和未暫存的變更都會遺失，且無法復原。"
          }
        }
      }
    },
    "Restore %@ to its last staged or committed content? Unstaged changes will be lost and cannot be recovered.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استعادة %@ إلى آخر محتوى مجهّز أو مُودَع؟ ستُفقد التغييرات غير المجهّزة ولن يمكن استعادتها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ auf den zuletzt vorgemerkten oder committeten Stand zurücksetzen? Nicht vorgemerkte Änderungen gehen verloren und können nicht wiederhergestellt werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Restaurar %@ a su último contenido preparado o commiteado? Los cambios sin preparar se perderán y no se podrán recuperar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaurer %@ à son dernier contenu indexé ou commité ? Les modifications non indexées seront perdues et ne pourront pas être récupérées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ripristinare %@ all’ultimo contenuto in stage o committato? Le modifiche non in stage andranno perse e non potranno essere recuperate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ を最後にステージまたはコミットした内容に戻しますか？ステージされていない変更は失われ、復元できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@을(를) 마지막으로 스테이징되거나 커밋된 내용으로 복원할까요? 스테이징되지 않은 변경 사항은 사라지며 복구할 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaurar %@ ao último conteúdo preparado ou commitado? As alterações não preparadas serão perdidas e não poderão ser recuperadas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Восстановить %@ до последнего проиндексированного или закоммиченного содержимого? Непроиндексированные изменения будут потеряны без возможности восстановления."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khôi phục %@ về nội dung đã đưa vào vùng chờ hoặc đã commit gần nhất? Thay đổi chưa đưa vào vùng chờ sẽ mất và không thể khôi phục."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把 %@ 还原成上次暂存或提交的内容？未暂存的改动会丢失，且无法找回。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把 %@ 還原成上次暫存或提交的內容？未暫存的變更會遺失，且無法復原。"
          }
        }
      }
    },
