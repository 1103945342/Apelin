          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "패키지 저장소는 GitHub Pages의 APT 소스입니다. ‘배포…’가 프로젝트의 릴리스 빌드를 여기에 게시합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um repositório de pacotes é uma fonte APT no GitHub Pages: “Distribuir…” publica nele as compilações de versão de um projeto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Репозиторий пакетов — это источник APT на GitHub Pages: «Распространить…» публикует в него релизные сборки проекта."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kho gói là một nguồn APT trên GitHub Pages: “Phân phối…” sẽ phát hành các bản dựng phát hành của dự án lên đó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "软件源仓库是托管在 GitHub Pages 上的 APT 软件源：“分发…”会把项目的发布构建发布到这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "套件儲存庫是託管在 GitHub Pages 上的 APT 來源：「發佈…」會把專案的發佈建置發佈到這裡。"
          }
        }
      }
    },
    "A package your package manager installs on a jailbroken device.": {
