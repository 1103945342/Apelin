    "One side was larger than the page can read.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كان أحد الجانبين أكبر مما يمكن للصفحة قراءته."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Seite war größer, als die Ansicht lesen kann."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un lado era más grande de lo que la página puede leer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un côté était plus volumineux que ce que la page peut lire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un lato era più grande di quanto la pagina possa leggere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "片側がページで読み取れる大きさを超えています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한쪽이 페이지에서 읽을 수 있는 크기를 넘었습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um dos lados era maior do que a página consegue ler."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одна из сторон больше, чем может прочитать страница."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một bên lớn hơn mức trang có thể đọc."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其中一侧超出了页面可读取的大小。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "其中一側超出了頁面可讀取的大小。"
          }
        }
      }
    },
    "Only the workspace root can be opened as a repository here.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هنا يمكن فتح جذر مساحة العمل فقط كمستودع."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier kann nur der Stamm des Arbeitsbereichs als Repository geöffnet werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí solo se puede abrir la raíz del espacio de trabajo como repositorio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ici, seule la racine de l’espace de travail peut être ouverte comme dépôt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qui è possibile aprire come repository solo la radice dello spazio di lavoro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここではワークスペースのルートだけをリポジトリとして開けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기에서는 작업 공간 루트만 저장소로 열 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aqui, apenas a raiz do espaço de trabalho pode ser aberta como repositório."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь как репозиторий можно открыть только корень рабочего пространства."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tại đây chỉ có thể mở thư mục gốc của không gian làm việc làm kho lưu trữ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此处只能将工作区根目录作为仓库打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此處只能將工作區根目錄作為儲存庫開啟。"
          }
        }
      }
    },
