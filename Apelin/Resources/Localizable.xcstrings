    "A chat or another window changed these memories. Reopen the memory to review the latest version before editing.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "غيّرت محادثةٌ أو نافذةٌ أخرى هذه الذكريات. أعد فتح الذكرى لمراجعة أحدث نسخة قبل التعديل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Chat oder ein anderes Fenster hat diese Erinnerungen geändert. Öffne die Erinnerung erneut, um vor dem Bearbeiten die neueste Version zu prüfen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A chat or another window changed these memories. Reopen the memory to review the latest version before editing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un chat u otra ventana ha modificado estas memorias. Vuelve a abrir la memoria para revisar la versión más reciente antes de editarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une discussion ou une autre fenêtre a modifié ces souvenirs. Rouvrez le souvenir pour consulter la dernière version avant de le modifier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una chat o un’altra finestra ha modificato queste memorie. Riapri la memoria per vedere la versione più recente prima di modificarla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チャットまたは別のウインドウでメモリが変更されました。編集する前に、メモリを開き直して最新の内容を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "채팅 또는 다른 윈도우에서 메모리가 변경되었습니다. 편집하기 전에 메모리를 다시 열어 최신 내용을 확인하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma conversa ou outra janela alterou estas memórias. Abra a memória novamente para revisar a versão mais recente antes de editar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эти воспоминания изменены в чате или другом окне. Откройте воспоминание снова и проверьте последнюю версию, прежде чем редактировать."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một cuộc trò chuyện hoặc cửa sổ khác đã thay đổi các ghi nhớ này. Hãy mở lại ghi nhớ để xem phiên bản mới nhất trước khi sửa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "聊天或其他窗口已更改这些记忆。请重新打开，查看最新内容后再编辑。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "聊天或其他視窗已變更這些記憶。請重新打開記憶，查看最新內容後再編輯。"
          }
        }
      }
    },
    "A compatible toolchain and iOS SDK, selected for this device. You can also install them later in Settings.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سلسلة أدوات وiOS SDK متوافقان، تم اختيارهما لهذا الجهاز. يمكنك أيضًا تثبيتهما لاحقًا في «الإعدادات»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine kompatible Toolchain und ein iOS SDK, für dieses Gerät ausgewählt. Du kannst sie auch später in den Einstellungen installieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A compatible toolchain and iOS SDK, selected for this device. You can also install them later in Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una cadena de herramientas y un SDK de iOS compatibles, elegidos para este dispositivo. También puedes instalarlos más tarde en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une chaîne d’outils et un SDK iOS compatibles, choisis pour cet appareil. Vous pouvez aussi les installer plus tard dans Réglages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una toolchain e un SDK iOS compatibili, scelti per questo dispositivo. Puoi anche installarli più tardi in Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイス向けに選ばれた、互換性のあるツールチェーンとiOS SDKです。あとで「設定」でインストールすることもできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에 맞게 선택된 호환 툴체인과 iOS SDK입니다. 나중에 ‘설정’에서 설치할 수도 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma cadeia de ferramentas e um SDK do iOS compatíveis, escolhidos para este dispositivo. Você também pode instalá-los depois em Ajustes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Совместимые набор инструментов и iOS SDK, подобранные для этого устройства. Их также можно установить позже в «Настройках»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chuỗi công cụ và iOS SDK tương thích, được chọn cho thiết bị này. Bạn cũng có thể cài đặt chúng sau trong Cài đặt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为此设备选择兼容的工具链和 iOS SDK。你也可以稍后在设置中安装。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為此裝置選擇的相容工具鏈和 iOS SDK。你也可以稍後在「設定」中安裝。"
          }
        }
      }
    },
    "A dylib injected into SpringBoard that hooks -[SpringBoard applicationDidFinishLaunching:] and logs when it loads.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مكتبة dylib تُحقن في SpringBoard، تعترض -[SpringBoard applicationDidFinishLaunching:] وتكتب في السجل عند تحميلها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine in SpringBoard injizierte dylib, die -[SpringBoard applicationDidFinishLaunching:] hookt und beim Laden einen Protokolleintrag schreibt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A dylib injected into SpringBoard that hooks -[SpringBoard applicationDidFinishLaunching:] and logs when it loads."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una dylib inyectada en SpringBoard que intercepta -[SpringBoard applicationDidFinishLaunching:] y deja un registro al cargarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une dylib injectée dans SpringBoard qui intercepte -[SpringBoard applicationDidFinishLaunching:] et écrit dans le journal à son chargement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una dylib iniettata in SpringBoard che aggancia -[SpringBoard applicationDidFinishLaunching:] e scrive nel log quando viene caricata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SpringBoardに注入され、-[SpringBoard applicationDidFinishLaunching:] をフックし、読み込まれたときにログを出力するdylib。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SpringBoard에 주입되어 -[SpringBoard applicationDidFinishLaunching:]을 후킹하고, 로드될 때 로그를 남기는 dylib입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma dylib injetada no SpringBoard que intercepta -[SpringBoard applicationDidFinishLaunching:] e grava um registro quando é carregada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Библиотека dylib, внедряемая в SpringBoard: перехватывает -[SpringBoard applicationDidFinishLaunching:] и пишет в журнал при загрузке."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một dylib được nạp vào SpringBoard, hook -[SpringBoard applicationDidFinishLaunching:] và ghi nhật ký khi được tải."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "注入 SpringBoard 的 dylib，挂钩 -[SpringBoard applicationDidFinishLaunching:]，并在加载时写入日志。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "注入 SpringBoard 的 dylib，會掛鉤 -[SpringBoard applicationDidFinishLaunching:]，並在載入時寫入日誌。"
          }
        }
      }
    },
    "A figure set here is the one your conversations read this model against, in place of what the provider reports.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أي قيمة تُضبط هنا هي ما تقرأ به محادثاتك هذا النموذج بدلًا مما يذكره المزوّد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein hier gesetzter Wert ist der, gegen den deine Gespräche dieses Modell lesen, statt der Angabe des Anbieters."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A figure set here is the one your conversations read this model against, in place of what the provider reports."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cifra que fijes aquí es la que tus conversaciones usan para este modelo, en lugar de lo que indica el proveedor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La valeur définie ici est celle que vos conversations utilisent pour ce modèle, à la place de ce qu’indique le fournisseur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il valore impostato qui è quello che le tue conversazioni usano per questo modello, al posto di quanto indicato dal fornitore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここで設定した値が、プロバイダーの報告値の代わりに会話で使われます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기서 설정한 값이 제공자가 알리는 값 대신 대화에서 사용됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O valor definido aqui é o que suas conversas usam para este modelo, no lugar do que o provedor informa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заданное здесь значение используется в разговорах вместо того, что сообщает провайдер."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giá trị đặt ở đây được hội thoại dùng cho mô hình này thay cho giá trị nhà cung cấp báo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这里设定的数值会取代服务商上报的数值，用于你的对话。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這裡設定的數值會取代服務商上報的數值，用於你的對話。"
          }
        }
      }
    },
    "A folder cannot be put inside itself.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن وضع مجلد داخل نفسه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Ordner kann nicht in sich selbst gelegt werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una carpeta no se puede colocar dentro de sí misma."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un dossier ne peut pas être placé dans lui-même."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una cartella non può essere inserita dentro se stessa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォルダーを自身の中に入れることはできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "폴더를 자기 안에 넣을 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma pasta não pode ser colocada dentro dela mesma."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Папку нельзя поместить внутрь неё самой."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể đặt thư mục vào chính nó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不能把文件夹放进它自己里面。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不能把資料夾放進它自己裡面。"
          }
        }
      }
    },
    "A merge is in progress. Resolve the conflicts and commit, or abort it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هناك دمج قيد التنفيذ. حُلّ التعارضات وأودِع، أو ألغِ الدمج."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Merge läuft. Löse die Konflikte und committe, oder brich ihn ab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay una fusión en curso. Resuelve los conflictos y haz commit, o cancélala."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une fusion est en cours. Résolvez les conflits et créez un commit, ou abandonnez-la."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una fusione è in corso. Risolvi i conflitti ed esegui il commit, oppure annullala."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マージの途中です。競合を解決してコミットするか、マージを中止してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "병합이 진행 중입니다. 충돌을 해결하고 커밋하거나 병합을 중단하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma mesclagem está em andamento. Resolva os conflitos e faça commit, ou aborte-a."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Идёт слияние. Разрешите конфликты и зафиксируйте изменения или отмените слияние."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang có một lần hợp nhất. Hãy giải quyết xung đột rồi commit, hoặc hủy bỏ nó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在合并。请解决冲突并提交，或中止合并。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在合併。請解決衝突並提交，或中止合併。"
          }
        }
      }
    },
    "A minimal iOS app, zipped. Installs on this device, or signs for another with a certificate.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تطبيق iOS بسيط داخل ملف مضغوط. يُثبَّت على هذا الجهاز، أو يُوقَّع بشهادة لجهاز آخر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine minimale iOS-App im ZIP. Lässt sich hier installieren oder mit einem Zertifikat für ein anderes Gerät signieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A minimal iOS app, zipped. Installs on this device, or signs for another with a certificate."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una app iOS mínima comprimida. Se instala en este dispositivo o se firma con un certificado para otro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une app iOS minimale, zippée. S’installe ici ou se signe avec un certificat pour un autre appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un’app iOS minimale, zippata. Si installa qui o si firma con un certificato per un altro dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最小限の iOS アプリを ZIP にしたもの。このデバイスにインストールするか、証明書で別のデバイス向けに署名します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최소한의 iOS 앱을 ZIP으로 묶은 것입니다. 이 기기에 설치하거나 인증서로 다른 기기에 맞게 서명할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um app iOS mínimo, compactado. Instala neste dispositivo ou é assinado com um certificado para outro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Минимальное приложение iOS в архиве. Устанавливается здесь или подписывается сертификатом для другого устройства."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một ứng dụng iOS tối giản, nén lại. Cài trên thiết bị này, hoặc ký bằng chứng chỉ cho thiết bị khác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "压缩后的极简 iOS 应用。可安装到本机，也可用证书签名后安装到另一台设备。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "壓縮後的極簡 iOS 應用程式。可安裝到本機，也可用憑證簽名後安裝到另一台裝置。"
          }
        }
      }
    },
    "A name cannot hold a slash or a colon.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن أن يحتوي الاسم على شرطة مائلة أو نقطتين."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Name darf keinen Schrägstrich und keinen Doppelpunkt enthalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El nombre no puede contener una barra ni dos puntos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un nom ne peut pas contenir de barre oblique ni de deux-points."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un nome non può contenere barre o due punti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前にスラッシュやコロンは使えません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이름에는 슬래시나 콜론을 넣을 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O nome não pode conter barra nem dois-pontos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Имя не может содержать косую черту или двоеточие."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tên không được chứa dấu gạch chéo hay dấu hai chấm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "名字里不能有斜杠或冒号。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "名字裡不能有斜線或冒號。"
          }
        }
      }
    },
    "A name is needed.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الاسم مطلوب."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Name ist erforderlich."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se necesita un nombre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un nom est nécessaire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Serve un nome."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이름이 필요합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "É preciso um nome."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нужно имя."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cần một tên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要填一个名字。"
