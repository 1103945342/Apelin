    "Leave it empty to use the name shown for now. Your agent will name the project once it knows what you’re making.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اتركه فارغًا لاستخدام الاسم المعروض حاليًا. سيسمّي الوكيل المشروع بعد أن يعرف ما الذي تصنعه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lass das Feld leer, um vorerst den angezeigten Namen zu verwenden. Dein Agent benennt das Projekt, sobald er weiß, was du baust."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leave it empty to use the name shown for now. Your agent will name the project once it knows what you’re making."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Déjalo vacío para usar por ahora el nombre que se muestra. Tu agente pondrá nombre al proyecto cuando sepa qué estás creando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Laissez vide pour utiliser le nom affiché pour l’instant. Votre agent nommera le projet dès qu’il saura ce que vous créez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lascia vuoto per usare per ora il nome mostrato. L’agente darà un nome al progetto quando saprà cosa stai creando."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空欄のままにすると、表示中の名前がひとまず使われます。何を作るのかがわかった時点で、エージェントがプロジェクトに名前を付けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비워 두면 표시된 이름을 일단 사용합니다. 무엇을 만드는지 알게 되면 에이전트가 프로젝트 이름을 정합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixe em branco para usar o nome mostrado por enquanto. Seu agente dará um nome ao projeto quando souber o que você está criando."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оставьте поле пустым, чтобы пока использовать показанное название. Агент назовёт проект, когда поймёт, что вы создаёте."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để trống để tạm dùng tên đang hiển thị. Tác nhân sẽ đặt tên cho dự án khi biết bạn đang làm gì."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "留空则暂用框中显示的名字，智能体了解你要做什么之后会为项目命名。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "留空則暫時使用目前顯示的名稱。代理程式了解你要做什麼之後，會為專案命名。"
          }
        }
      }
    },
    "Leave it empty to use the repository’s name.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اتركه فارغًا لاستخدام اسم المستودع."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leer lassen, um den Namen des Repositorys zu verwenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leave it empty to use the repository’s name."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Déjalo vacío para usar el nombre del repositorio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Laissez vide pour utiliser le nom du dépôt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lascia vuoto per usare il nome del repository."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空欄にするとリポジトリ名を使います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비워 두면 저장소 이름을 사용합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixe vazio para usar o nome do repositório."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оставьте пустым, чтобы использовать имя репозитория."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để trống để dùng tên kho."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "留空则使用仓库名称。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "留空則使用儲存庫名稱。"
          }
        }
      }
    },
    "Let the agent run commands as root without asking.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "السماح للوكيل بتنفيذ الأوامر بصلاحيات الجذر دون سؤال."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dem Agenten erlauben, Befehle ohne Nachfrage als root auszuführen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir que el agente ejecute comandos como root sin preguntar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autoriser l’agent à exécuter des commandes en tant que root sans demander."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti all’agente di eseguire comandi come root senza chiedere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントが確認せずに root としてコマンドを実行できるようにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트가 묻지 않고 명령을 root로 실행하도록 허용합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir que o agente execute comandos como root sem perguntar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешить агенту выполнять команды от имени root без вопросов."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho phép tác nhân chạy lệnh với quyền root mà không hỏi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许智能体无需确认即以 root 身份运行命令。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "允許代理程式不經詢問即以 root 身分執行指令。"
          }
        }
      }
    },
