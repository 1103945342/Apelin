    "Strict": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صارم"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Streng"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Strict"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estricto"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Strict"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rigorosa"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "厳格"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "엄격"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estrito"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Строгий"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nghiêm ngặt"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "严格"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "嚴格"
          }
        }
      }
    },
    "Strict: asks before commands and sensitive changes.\n\nRelaxed: runs these operations without asking, within the app’s permissions, but asks before any command that runs as root.\n\nFull: runs commands as root without asking too.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صارم: يسأل قبل الأوامر والتغييرات الحساسة.\n\nمتساهل: ينفّذ هذه العمليات دون سؤال، ضمن أذونات التطبيق، لكنه يسأل قبل أي أمر يعمل بصلاحيات الجذر.\n\nكامل: ينفّذ الأوامر بصلاحيات الجذر دون سؤال أيضًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Streng: fragt vor Befehlen und sensiblen Änderungen.\n\nLocker: führt diese Vorgänge ohne Nachfrage im Rahmen der App-Berechtigungen aus, fragt aber vor jedem Befehl, der als root läuft.\n\nVollständig: führt auch Befehle als root ohne Nachfrage aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Strict: asks before commands and sensitive changes.\n\nRelaxed: runs these operations without asking, within the app’s permissions, but asks before any command that runs as root.\n\nFull: runs commands as root without asking too."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estricto: pregunta antes de comandos y cambios sensibles.\n\nFlexible: ejecuta estas operaciones sin preguntar, dentro de los permisos de la app, pero pregunta antes de cualquier comando que se ejecute como root.\n\nCompleto: también ejecuta comandos como root sin preguntar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Strict : demande avant les commandes et les modifications sensibles.\n\nSouple : exécute ces opérations sans demander, dans la limite des autorisations de l’app, mais demande avant toute commande exécutée en tant que root.\n\nComplet : exécute aussi les commandes en tant que root sans demander."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rigorosa: chiede prima dei comandi e delle modifiche sensibili.\n\nPermissiva: esegue queste operazioni senza chiedere, entro i permessi dell’app, ma chiede prima di qualsiasi comando eseguito come root.\n\nCompleta: esegue anche i comandi come root senza chiedere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "厳格：コマンドや慎重な変更の前に確認します。\n\n緩和：Appの権限の範囲内でこれらの操作を確認せずに実行しますが、root として実行するコマンドの前には確認します。\n\n完全：root としてのコマンドも確認せずに実行します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "엄격: 명령과 민감한 변경 전에 묻습니다.\n\n완화: 앱 권한 범위 내에서 이러한 작업을 묻지 않고 실행하지만, root로 실행하는 명령 전에는 묻습니다.\n\n전체: root 명령도 묻지 않고 실행합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estrito: pergunta antes de comandos e alterações sensíveis.\n\nFlexível: executa essas operações sem perguntar, dentro das permissões do app, mas pergunta antes de qualquer comando executado como root.\n\nCompleto: também executa comandos como root sem perguntar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Строгий: спрашивает перед командами и важными изменениями.\n\nСвободный: выполняет эти операции без вопросов в пределах прав приложения, но спрашивает перед любой командой, выполняемой от имени root.\n\nПолный: выполняет команды от имени root тоже без вопросов."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nghiêm ngặt: hỏi trước khi chạy lệnh và thực hiện thay đổi nhạy cảm.\n\nLinh hoạt: chạy các thao tác này mà không hỏi, trong phạm vi quyền của ứng dụng, nhưng hỏi trước bất kỳ lệnh nào chạy với quyền root.\n\nToàn quyền: chạy cả lệnh với quyền root mà không hỏi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "严格：执行命令和敏感更改前询问。\n\n宽松：在应用权限范围内直接执行这些操作，但任何以 root 身份运行的命令都会先询问。\n\n完全：以 root 身份运行命令也不再询问。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "嚴格：執行指令和敏感變更前詢問。\n\n寬鬆：在 App 權限範圍內直接執行這些操作，但任何以 root 身分執行的指令都會先詢問。\n\n完全：以 root 身分執行指令也不再詢問。"
          }
        }
      }
    },
    "Strict: asks before commands and sensitive changes. Relaxed: runs these operations without asking, within the app’s permissions. Each chat uses this setting when you send its next message.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صارم: يسأل قبل تنفيذ الأوامر والتغييرات الحساسة. متساهل: ينفّذ هذه العمليات دون سؤال، ضمن أذونات التطبيق. تستخدم كل محادثة هذا الإعداد عند إرسال رسالتها التالية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Streng: fragt vor Befehlen und heiklen Änderungen. Locker: führt diese Aktionen ohne Nachfrage aus, im Rahmen der Berechtigungen der App. Jeder Chat übernimmt diese Einstellung, wenn du seine nächste Nachricht sendest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estricto: pregunta antes de ejecutar comandos y hacer cambios delicados. Flexible: realiza estas operaciones sin preguntar, dentro de los permisos de la app. Cada chat usa este ajuste cuando envías su siguiente mensaje."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Strict : demande avant les commandes et les modifications sensibles. Souple : exécute ces opérations sans demander, dans la limite des autorisations de l’app. Chaque discussion applique ce réglage lorsque vous envoyez son prochain message."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rigorosa: chiede prima di comandi e modifiche sensibili. Permissiva: esegue queste operazioni senza chiedere, entro i permessi dell’app. Ogni chat usa questa impostazione quando invii il suo prossimo messaggio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "厳格：コマンドの実行や重要な変更の前に確認します。緩和：Appの権限の範囲内で、これらの操作を確認せずに実行します。各チャットでは、次にメッセージを送信したときからこの設定が使われます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "엄격: 명령을 실행하거나 민감한 변경을 하기 전에 묻습니다. 완화: 앱 권한 범위 내에서 이러한 작업을 묻지 않고 실행합니다. 각 채팅은 다음 메시지를 보낼 때부터 이 설정을 사용합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estrito: pergunta antes de executar comandos e fazer alterações sensíveis. Flexível: realiza essas operações sem perguntar, dentro das permissões do app. Cada conversa usa este ajuste quando você envia a próxima mensagem dela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Строгий: спрашивает перед командами и важными изменениями. Свободный: выполняет такие операции без вопросов в пределах прав приложения. Каждый чат применит настройку, когда вы отправите в нём следующее сообщение."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nghiêm ngặt: hỏi trước khi chạy lệnh và thực hiện thay đổi nhạy cảm. Linh hoạt: thực hiện các thao tác này mà không hỏi, trong phạm vi quyền của ứng dụng. Mỗi cuộc trò chuyện sẽ dùng cài đặt này khi bạn gửi tin nhắn tiếp theo trong đó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "严格：执行命令和敏感更改前询问。宽松：在应用权限范围内直接执行这些操作。每个聊天会在你下次发送消息时使用此设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "嚴格：執行指令和敏感變更前會先詢問。寬鬆：在 App 權限範圍內直接執行這些操作，不會詢問。每個聊天會在你傳送下一則訊息時套用此設定。"
          }
        }
      }
    },
    "Strict: asks before commands and sensitive changes. Relaxed: runs these operations without asking, within the app’s permissions. This setting applies to all chats.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صارم: يسأل قبل تنفيذ الأوامر والتغييرات الحساسة. متساهل: ينفّذ هذه العمليات دون سؤال، ضمن أذونات التطبيق. ينطبق هذا الإعداد على كل المحادثات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Streng: fragt vor Befehlen und heiklen Änderungen. Locker: führt diese Aktionen ohne Nachfrage aus, im Rahmen der Berechtigungen der App. Diese Einstellung gilt für alle Chats."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Strict: asks before commands and sensitive changes. Relaxed: runs these operations without asking, within the app’s permissions. This setting applies to all chats."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estricto: pregunta antes de ejecutar comandos y hacer cambios delicados. Flexible: realiza estas operaciones sin preguntar, dentro de los permisos de la app. Este ajuste se aplica a todos los chats."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Strict : demande avant les commandes et les modifications sensibles. Souple : exécute ces opérations sans demander, dans la limite des autorisations de l’app. Ce réglage s’applique à toutes les discussions."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rigorosa: chiede prima di comandi e modifiche sensibili. Permissiva: esegue queste operazioni senza chiedere, entro i permessi dell’app. Questa impostazione vale per tutte le chat."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "厳格：コマンドの実行や重要な変更の前に確認します。緩和：Appの権限の範囲内で、これらの操作を確認せずに実行します。この設定はすべてのチャットに適用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "엄격: 명령을 실행하거나 민감한 변경을 하기 전에 묻습니다. 완화: 앱 권한 범위 내에서 이러한 작업을 묻지 않고 실행합니다. 이 설정은 모든 채팅에 적용됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estrito: pergunta antes de executar comandos e fazer alterações sensíveis. Flexível: realiza essas operações sem perguntar, dentro das permissões do app. Este ajuste se aplica a todas as conversas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Строгий: спрашивает перед командами и важными изменениями. Свободный: выполняет такие операции без вопросов в пределах прав приложения. Настройка действует для всех чатов."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nghiêm ngặt: hỏi trước khi chạy lệnh và thực hiện thay đổi nhạy cảm. Linh hoạt: thực hiện các thao tác này mà không hỏi, trong phạm vi quyền của ứng dụng. Cài đặt này áp dụng cho mọi cuộc trò chuyện."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "严格：执行命令和敏感更改前请求确认。宽松：在应用权限范围内直接执行，无需逐次确认。此设置适用于所有对话。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "嚴格：執行指令和敏感變更前會先詢問。寬鬆：在 App 權限範圍內直接執行這些操作，不會詢問。此設定適用於所有聊天。"
          }
        }
      }
    },
