    "Reset current branch to commit %@?": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إعادة تعيين الفرع الحالي إلى الإيداع %@؟"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktuellen Branch auf Commit %@ zurücksetzen?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Restablecer la rama actual al commit %@?"
          }
        },
