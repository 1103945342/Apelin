          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión en la cuenta que el agente usa para escribir, compilar e instalar tus tweaks."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous au compte que l’agent utilise pour écrire, compiler et installer vos tweaks."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accedi all’account che l’agente usa per scrivere, compilare e installare i tuoi tweak."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントがTweakの作成、ビルド、インストールに使用するアカウントにサインインしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
