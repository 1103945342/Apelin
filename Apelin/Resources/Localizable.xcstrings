    },
    "This reply leaves the chat. The rest of the chat stays.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُزال هذا الرد من المحادثة. ويبقى باقيها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Antwort wird aus dem Chat entfernt. Der Rest bleibt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This reply leaves the chat. The rest of the chat stays."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta respuesta se quita del chat. El resto del chat se mantiene."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette réponse est retirée de la discussion. Le reste est conservé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa risposta viene tolta dalla chat. Il resto rimane."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この返信はチャットから削除されます。ほかの部分はそのまま残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 답변은 채팅에서 삭제됩니다. 나머지는 그대로 남습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta resposta sai do chat. O restante permanece."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот ответ будет удалён из чата. Остальное останется."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Câu trả lời này sẽ bị xóa khỏi cuộc trò chuyện. Phần còn lại vẫn giữ nguyên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这条回复会从对话中删除，其余内容保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這則回覆會從對話中刪除，其餘內容保留。"
          }
        }
      }
    },
