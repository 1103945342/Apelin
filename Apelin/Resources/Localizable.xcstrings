    "Delete %@? It has never been committed, so Git cannot recover it after deletion.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حذف %@؟ لم يُودَع قط، لذا لا يمكن لـ Git استعادته بعد الحذف."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ löschen? Die Datei wurde nie committet, Git kann sie nach dem Löschen nicht wiederherstellen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Eliminar %@? Nunca se ha commiteado, así que Git no podrá recuperarlo tras eliminarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer %@ ? Il n’a jamais été commité, Git ne pourra pas le récupérer après suppression."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminare %@? Non è mai stato committato, quindi Git non può recuperarlo dopo l’eliminazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ を削除しますか？一度もコミットされていないため、削除後は Git で復元できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@을(를) 삭제할까요? 한 번도 커밋된 적이 없어 삭제 후 Git으로 복구할 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Excluir %@? Nunca foi commitado, então o Git não pode recuperá-lo após a exclusão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить %@? Файл ни разу не был закоммичен, и Git не сможет восстановить его после удаления."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xóa %@? Tệp chưa từng được commit nên Git không thể khôi phục sau khi xóa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除 %@？它从未被提交过，删除后无法通过 Git 恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除 %@？它從未提交過，刪除後無法透過 Git 還原。"
          }
        }
      }
    },
