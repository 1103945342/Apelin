  "These models are used for auxiliary tasks and do not change the model selected for a conversation.": {
    "extractionState": "manual",
    "localizations": {
      "ar": {
        "stringUnit": {
          "state": "translated",
          "value": "تُستخدم هذه النماذج لمهام مساعدة ولا تغيّر النموذج المحدد للمحادثة."
        }
      },
      "de": {
        "stringUnit": {
          "state": "translated",
          "value": "Diese Modelle werden für Hilfsaufgaben verwendet und ändern nicht das für eine Unterhaltung ausgewählte Modell."
        }
      },
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "These models are used for auxiliary tasks and do not change the model selected for a conversation."
        }
      },
      "es": {
        "stringUnit": {
          "state": "translated",
          "value": "Estos modelos se usan para tareas auxiliares y no cambian el modelo seleccionado para una conversación."
        }
      },
      "fr": {
        "stringUnit": {
          "state": "translated",
          "value": "Ces modèles servent aux tâches auxiliaires et ne modifient pas le modèle sélectionné pour une conversation."
        }
      },
      "it": {
        "stringUnit": {
          "state": "translated",
          "value": "Questi modelli vengono usati per attività ausiliarie e non cambiano il modello selezionato per una conversazione."
        }
      },
      "ja": {
        "stringUnit": {
          "state": "translated",
          "value": "これらのモデルは補助的なタスクに使用され、会話で選択したモデルは変更されません。"
        }
      },
      "ko": {
        "stringUnit": {
          "state": "translated",
          "value": "이 모델은 보조 작업에 사용되며 대화에서 선택한 모델을 변경하지 않습니다."
        }
      },
      "pt-BR": {
        "stringUnit": {
          "state": "translated",
          "value": "Esses modelos são usados para tarefas auxiliares e não alteram o modelo selecionado para uma conversa."
        }
      },
      "ru": {
        "stringUnit": {
          "state": "translated",
          "value": "Эти модели используются для вспомогательных задач и не меняют модель, выбранную для разговора."
        }
      },
      "vi": {
        "stringUnit": {
          "state": "translated",
          "value": "Các mô hình này được dùng cho tác vụ phụ trợ và không thay đổi mô hình đã chọn cho cuộc trò chuyện."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "这些模型用于辅助任务，不会更改对话中所选的模型。"
        }
      },
      "zh-Hant": {
        "stringUnit": {
          "state": "translated",
          "value": "這些模型用於輔助任務，不會變更對話中選取的模型。"
        }
      }
    }
  },
