    "A C program with --version and --help that greets its argument and exits with sysexits codes.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "برنامج C يدعم الخيارين --version و--help، يحيّي الوسيط الذي يتلقاه ويخرج برموز sysexits."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein C-Programm mit --version und --help, das sein Argument begrüßt und mit sysexits-Codes endet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A C program with --version and --help that greets its argument and exits with sysexits codes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un programa en C con --version y --help que saluda a su argumento y termina con códigos de sysexits."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un programme C avec --version et --help qui salue son argument et se termine avec des codes sysexits."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un programma C con --version e --help che saluta il suo argomento ed esce con codici sysexits."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "--version と --help に対応し、引数にあいさつしてsysexitsの終了コードで終了するCプログラム。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "--version과 --help를 지원하고, 인수에게 인사한 뒤 sysexits 종료 코드로 끝나는 C 프로그램입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um programa em C com --version e --help que cumprimenta o argumento e encerra com códigos sysexits."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Программа на C с --version и --help: приветствует свой аргумент и завершается с кодами sysexits."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chương trình C có --version và --help, chào đối số được truyền vào và thoát với mã sysexits."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "支持 --version 和 --help 的 C 程序，向参数打招呼，并以 sysexits 退出码退出。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "支援 --version 和 --help 的 C 程式，會向引數打招呼，並以 sysexits 結束代碼結束。"
          }
        }
      }
    },
    "A Foundation command-line tool with a greeting, --version, --help, standard sysexits exit codes and iOS version output.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أداة سطر أوامر مبنية على Foundation، تتضمن تحية و--version و--help ورموز خروج sysexits القياسية وعرض إصدار iOS."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Foundation-Befehlszeilentool mit Begrüßung, --version, --help, standardmäßigen sysexits-Exitcodes und Ausgabe der iOS-Version."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A Foundation command-line tool with a greeting, --version, --help, standard sysexits exit codes and iOS version output."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una herramienta de línea de comandos con Foundation que incluye un saludo, --version, --help, los códigos de salida estándar de sysexits y muestra la versión de iOS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un outil en ligne de commande Foundation avec un message d’accueil, --version, --help, des codes de sortie sysexits standard et l’affichage de la version d’iOS."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Uno strumento da riga di comando Foundation con un saluto, --version, --help, codici di uscita sysexits standard e la versione di iOS in output."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あいさつ、--version、--help、標準のsysexits終了コード、iOSバージョンの出力を備えた、Foundationベースのコマンドラインツール。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인사말, --version, --help, 표준 sysexits 종료 코드, iOS 버전 출력을 갖춘 Foundation 기반 명령줄 도구입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma ferramenta de linha de comando com Foundation que inclui uma saudação, --version, --help, os códigos de saída padrão sysexits e exibe a versão do iOS."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Утилита командной строки на Foundation с приветствием, --version, --help, стандартными кодами выхода sysexits и выводом версии iOS."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Công cụ dòng lệnh dùng Foundation, có lời chào, --version, --help, mã thoát sysexits chuẩn và in ra phiên bản iOS."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "基于 Foundation 的命令行工具，带问候语、--version、--help、标准 sysexits 退出码，并输出 iOS 版本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "基於 Foundation 的命令列工具，具備問候語、--version、--help、標準 sysexits 結束代碼，並會輸出 iOS 版本。"
          }
        }
      }
    },
    "A Settings pane with a switch and text field, package-specific preferences and change notifications.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جزء في «الإعدادات» يحتوي على مفتاح تبديل وحقل نص، مع تفضيلات خاصة بالحزمة وإشعارات عند التغيير."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Einstellungsbereich mit Schalter und Textfeld, paketeigenen Einstellungen und Benachrichtigungen bei Änderungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A Settings pane with a switch and text field, package-specific preferences and change notifications."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un panel de Ajustes con un interruptor y un campo de texto, preferencias propias del paquete y notificaciones de cambios."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un panneau de Réglages avec un interrupteur et un champ de texte, des préférences propres au paquet et des notifications de modification."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un pannello di Impostazioni con un interruttore e un campo di testo, preferenze specifiche del pacchetto e notifiche di modifica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スイッチとテキストフィールド、パッケージ固有の環境設定、変更通知を備えた設定パネル。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스위치와 텍스트 필드, 패키지별 환경설정, 변경 알림을 갖춘 설정 패널입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um painel de Ajustes com um botão de ativação e um campo de texto, preferências próprias do pacote e notificações de alteração."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Панель в «Настройках» с переключателем и текстовым полем, собственными настройками пакета и уведомлениями об изменениях."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một khung Cài đặt có công tắc và ô văn bản, tùy chọn riêng của gói và thông báo khi thay đổi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "带开关和文本框的设置面板，使用软件包专属的偏好设置，并在更改时发送通知。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
