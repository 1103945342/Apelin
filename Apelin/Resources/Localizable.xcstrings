    "Files over 2000 lines or containing very long lines are not diffed line by line, to avoid rendering and memory pressure.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الملفات التي تتجاوز 2000 سطر أو تحتوي أسطرًا طويلة جدًا لا تتم مقارنتها سطرًا بسطر، لتجنب ضغط العرض والذاكرة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dateien mit über 2000 Zeilen oder sehr langen Zeilen werden nicht Zeile für Zeile verglichen, um Darstellung und Speicher zu schonen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los archivos de más de 2000 líneas o con líneas muy largas no se comparan línea por línea, para no cargar el dibujado ni la memoria."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers de plus de 2000 lignes ou contenant des lignes très longues ne sont pas comparés ligne par ligne, pour épargner l’affichage et la mémoire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I file con più di 2000 righe o con righe molto lunghe non vengono confrontati riga per riga, per non gravare su disegno e memoria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2000 行を超えるファイルや非常に長い行を含むファイルは、描画とメモリの負担を避けるため行単位で比較しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "2000줄이 넘거나 매우 긴 줄이 있는 파일은 렌더링과 메모리 부담을 피하기 위해 줄 단위로 비교하지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arquivos com mais de 2000 linhas ou com linhas muito longas não são comparados linha a linha, para poupar desenho e memória."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файлы длиннее 2000 строк или с очень длинными строками не сравниваются построчно, чтобы не нагружать отрисовку и память."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tệp dài hơn 2000 dòng hoặc có dòng rất dài sẽ không được so sánh từng dòng, để tránh áp lực hiển thị và bộ nhớ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "超过 2000 行或含有超长行的文件不会逐行比对，以免渲染和占用过多内存。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "超過 2000 行或含有超長行的檔案不會逐行比對，以免影響繪製與記憶體。"
          }
        }
      }
    },
