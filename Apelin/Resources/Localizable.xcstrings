    "A single-screen UIKit app in Swift. Requires an installed, verified Swift toolchain component.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تطبيق UIKit بشاشة واحدة مكتوب بلغة Swift. يتطلب مكوّن Swift مثبّتًا وتم التحقق منه في سلسلة الأدوات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine UIKit-App mit einem Bildschirm in Swift. Erfordert eine installierte, geprüfte Swift-Komponente der Toolchain."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A single-screen UIKit app in Swift. Requires an installed, verified Swift toolchain component."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una app UIKit de una sola pantalla en Swift. Requiere el componente Swift de la cadena de herramientas instalado y verificado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une app UIKit à écran unique en Swift. Nécessite un composant Swift de chaîne d’outils installé et vérifié."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un’app UIKit a schermata singola in Swift. Richiede un componente Swift della toolchain installato e verificato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Swiftで書かれた1画面構成のUIKit App。インストール済みで検証済みのSwiftツールチェーンコンポーネントが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Swift로 작성된 단일 화면 UIKit 앱입니다. 설치 및 검증된 Swift 툴체인 구성 요소가 필요합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um app UIKit de tela única em Swift. Requer o componente Swift da cadeia de ferramentas instalado e verificado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одноэкранное приложение UIKit на Swift. Требуется установленный и проверенный компонент Swift в наборе инструментов."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ứng dụng UIKit một màn hình viết bằng Swift. Cần thành phần Swift của chuỗi công cụ đã được cài đặt và xác minh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用 Swift 编写的单屏 UIKit App。需要已安装并通过验证的 Swift 工具链组件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以 Swift 撰寫的單一畫面 UIKit App。需要已安裝並通過驗證的 Swift 工具鏈元件。"
          }
        }
      }
    },
    "A single-screen UIKit app with scene support, saved-state cleanup and entitlements for running outside a container.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تطبيق UIKit بشاشة واحدة يدعم المشاهد، وينظّف الحالة المحفوظة، ويتضمن الاستحقاقات اللازمة للعمل خارج الحاوية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine UIKit-App mit einem Bildschirm, Szenenunterstützung, Bereinigung des gespeicherten Zustands und Berechtigungen für die Ausführung außerhalb eines Containers."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A single-screen UIKit app with scene support, saved-state cleanup and entitlements for running outside a container."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una app UIKit de una sola pantalla con soporte de escenas, limpieza del estado guardado y los permisos para ejecutarse fuera de un contenedor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une app UIKit à écran unique, avec prise en charge des scènes, nettoyage de l’état enregistré et droits d’exécution hors conteneur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un’app UIKit a schermata singola con supporto delle scene, pulizia dello stato salvato e autorizzazioni per l’esecuzione fuori da un container."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シーン対応、保存された状態のクリーンアップ、コンテナ外で実行するためのエンタイトルメントを備えた、1画面構成のUIKit App。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "장면 지원, 저장된 상태 정리, 컨테이너 밖에서 실행하기 위한 엔타이틀먼트를 갖춘 단일 화면 UIKit 앱입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um app UIKit de tela única com suporte a cenas, limpeza do estado salvo e as permissões para rodar fora de um contêiner."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одноэкранное приложение UIKit с поддержкой сцен, очисткой сохранённого состояния и правами (entitlements) для работы вне контейнера."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ứng dụng UIKit một màn hình, hỗ trợ scene, dọn trạng thái đã lưu và có các quyền cần thiết để chạy bên ngoài container."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "单屏 UIKit App，支持场景，会清理保存的界面状态，并带有在容器外运行所需的权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "單一畫面的 UIKit App，支援場景，會清除儲存的介面狀態，並具備在容器外執行所需的權限。"
          }
        }
      }
    },
    "A skill can hold up to 2,000 files and 32 MB.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن أن تحتوي المهارة على ما يصل إلى 2000 ملف و32 ميغابايت."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Skill kann bis zu 2.000 Dateien und 32 MB enthalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A skill can hold up to 2,000 files and 32 MB."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una habilidad puede contener hasta 2000 archivos y 32 MB."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une compétence peut contenir jusqu’à 2 000 fichiers et 32 Mo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una competenza può contenere fino a 2.000 file e 32 MB."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スキルに含められるのは最大 2,000 ファイル、32 MB までです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스킬에는 최대 2,000개 파일, 32MB까지 담을 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma habilidade pode ter até 2.000 arquivos e 32 MB."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Навык может содержать до 2000 файлов и 32 МБ."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một kỹ năng có thể chứa tối đa 2.000 tệp và 32 MB."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一个技能最多包含 2,000 个文件、32 MB。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一個技能最多可包含 2,000 個檔案、32 MB。"
          }
        }
      }
    },
    "A toolchain holds programs that run on this device. Import only one you exported yourself. It is installed, then checked by compiling and running a program for each language, and set up only if that passes.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحتوي سلسلة الأدوات على برامج تعمل على هذا الجهاز. لا تستورد إلا سلسلة صدّرتها بنفسك. يتم تثبيتها، ثم فحصها بتجميع برنامج وتشغيله لكل لغة، ولا يكتمل إعدادها إلا إذا نجح ذلك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Toolchain enthält Programme, die auf diesem Gerät laufen. Importiere nur eine, die du selbst exportiert hast. Sie wird installiert, dann durch Kompilieren und Ausführen eines Programms für jede Sprache geprüft und nur eingerichtet, wenn das gelingt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una cadena de herramientas contiene programas que se ejecutan en este dispositivo. Importa solo una que hayas exportado tú. Se instala, se comprueba compilando y ejecutando un programa para cada lenguaje y solo se configura si supera la prueba."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une chaîne d’outils contient des programmes qui s’exécutent sur cet appareil. N’importez que celle que vous avez exportée vous-même. Elle est installée, puis vérifiée en compilant et en exécutant un programme pour chaque langage, et n’est configurée que si cette vérification réussit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una toolchain contiene programmi che vengono eseguiti su questo dispositivo. Importa solo una toolchain che hai esportato tu. Viene installata, poi verificata compilando ed eseguendo un programma per ogni linguaggio, e configurata solo se la verifica riesce."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ツールチェーンには、このデバイス上で実行されるプログラムが含まれています。自分でエクスポートしたものだけをインポートしてください。インストール後、言語ごとにプログラムをコンパイルして実行することで確認され、合格した場合にのみセットアップされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "툴체인에는 이 기기에서 실행되는 프로그램이 들어 있습니다. 직접 내보낸 툴체인만 가져오세요. 툴체인은 설치된 후 언어마다 프로그램을 컴파일하고 실행하여 확인되며, 이를 통과한 경우에만 설정됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma cadeia de ferramentas contém programas que rodam neste dispositivo. Importe apenas uma que você mesmo exportou. Ela é instalada, verificada compilando e executando um programa para cada linguagem e só é configurada se passar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Набор инструментов содержит программы, которые запускаются на этом устройстве. Импортируйте только тот, что экспортировали сами. Он устанавливается, затем проверяется компиляцией и запуском программы на каждом языке и настраивается, только если проверка пройдена."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chuỗi công cụ chứa các chương trình chạy trên thiết bị này. Chỉ nhập chuỗi công cụ do chính bạn xuất. Chuỗi công cụ sẽ được cài đặt, kiểm tra bằng cách biên dịch và chạy một chương trình cho mỗi ngôn ngữ, và chỉ được thiết lập nếu vượt qua."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "工具链包含会在这台设备上运行的程序。请只导入你自己导出的工具链。导入后会先安装，再为每种语言编译并运行一个程序来检查，通过后才会完成配置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "工具鏈包含會在此裝置上執行的程式。請只匯入你自己匯出的工具鏈。匯入後會先安裝，再為每種語言編譯並執行一個程式來檢查，通過後才會完成設定。"
          }
        }
      }
    },
